# Copy to .env (it is ignored by git).
# Shared secret that Laravel must send in the X-Api-Key header. Leave empty only for local development.
MEDIMATCH_AI_API_KEY=

# Embedding model: "e5" (intfloat/multilingual-e5-small, chosen in the evaluation) or "minilm"
MEDIMATCH_AI_SEMANTIC_MODEL=e5
# Load the model when the service starts (true) or on the first /match request (false)
MEDIMATCH_AI_PRELOAD_MODEL=true
